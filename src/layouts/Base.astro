---
import '../styles/global.css';
import { industries } from '../config/taxonomy';
import { regions } from '../config/regions';
import { byIndustry, byRegion } from '../lib/content';
import { site, locales, type Locale } from '../config/site';
import { t, localeTag } from '../lib/i18n';
import { href } from '../lib/url';

interface Props {
  locale: Locale;
  /** 不含语言前缀的逻辑路径，如 '/'、'/banking'、'/news/xxx' */
  path: string;
  title?: string;
  description?: string;
}

const { locale, path, title, description } = Astro.props;
const dict = t(locale);
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.tagline[locale]}`;
const desc = description ?? site.description[locale];
const canonical = new URL(href(`/${locale}${path}`), site.baseUrl).toString();

interface MenuItem {
  label: string;
  path: string;
  count: number;
}

const industryMenu: MenuItem[] = industries.map((industry) => ({
  label: industry.name[locale],
  path: `/${industry.slug}`,
  count: byIndustry(industry.slug).length,
}));

const regionMenu: MenuItem[] = regions.map((region) => ({
  label: region.name[locale],
  path: `/region/${region.slug}`,
  count: byRegion(region.slug).length,
}));

const nav: { label: string; path: string | null; menu?: MenuItem[] }[] = [
  { label: dict.home, path: '/' },
  { label: dict.industries, path: null, menu: industryMenu },
  { label: dict.regions, path: null, menu: regionMenu },
  { label: dict.archive, path: '/archive' },
  { label: dict.status, path: '/status' },
];

const isCurrent = (target: string | null) =>
  !target ? false : target === '/' ? path === '/' : path === target || path.startsWith(`${target}/`);

const menuCurrent = (menu?: MenuItem[]) => !!menu && menu.some((item) => isCurrent(item.path));
---

<!doctype html>
<html lang={localeTag[locale]} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.setAttribute(
            'data-theme',
            saved || (prefersDark ? 'dark' : 'light')
          );
        } catch (e) {
          /* 保持默认深色，避免首屏闪白 */
        }
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {!site.indexable && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="alternate" type="application/rss+xml" title={site.name} href={href('/rss.xml')} />
  </head>

  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href={href(`/${locale}/`)}><span>◈</span>{site.name}</a>
        <nav class="nav" aria-label="primary">
          {
            nav.map((item) =>
              item.menu ? (
                <details class="nav-menu" data-current={menuCurrent(item.menu) ? 'true' : undefined}>
                  <summary>{item.label}</summary>
                  <ul>
                    {item.menu.map((entry) => (
                      <li>
                        <a
                          href={href(`/${locale}${entry.path}`)}
                          aria-current={isCurrent(entry.path) ? 'page' : undefined}
                        >
                          <span>{entry.label}</span>
                          <span class="nav-count">{entry.count}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              ) : (
                <a
                  href={href(`/${locale}${item.path === '/' ? '/' : item.path}`)}
                  aria-current={isCurrent(item.path) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              )
            )
          }
        </nav>
        <div class="tools">
          <a
            class="icon-btn icon-btn--search"
            href={href(`/${locale}/search`)}
            aria-label={dict.search}
            title={dict.search}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="10.5" cy="10.5" r="6.6"></circle>
              <path d="M15.4 15.4 20.2 20.2"></path>
            </svg>
          </a>
          <div class="lang-switch">
            {
              locales.map((l) => (
                <a
                  href={href(`/${l}${path === '/' ? '/' : path}`)}
                  aria-current={l === locale ? 'true' : 'false'}
                  hreflang={l}
                >
                  {l.toUpperCase()}
                </a>
              ))
            }
          </div>
          <button
            class="icon-btn icon-btn--theme"
            id="theme-toggle"
            aria-label={dict.theme}
            title={dict.theme}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="8"></circle>
              <path class="half" d="M12 4a8 8 0 0 0 0 16z"></path>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="wrap footer-inner">
        <span>{site.name} · {site.tagline[locale]}</span>
      </div>
    </footer>

    <script is:inline>
      document.getElementById('theme-toggle')?.addEventListener('click', function () {
        var root = document.documentElement;
        var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        try {
          localStorage.setItem('theme', next);
        } catch (e) {}
      });

      document.addEventListener('click', function (event) {
        document.querySelectorAll('.nav-menu[open]').forEach(function (menu) {
          if (!menu.contains(event.target)) menu.removeAttribute('open');
        });
      });

      // 鼠标设备上悬停展开。120ms 意图延迟：没有它，光标从「首页」移向「归档」
      // 会连着扫开两个菜单。触屏与键盘仍走点击与 focus。
      if (window.matchMedia && window.matchMedia('(hover: hover)').matches) {
        document.querySelectorAll('.nav-menu').forEach(function (menu) {
          var openTimer, closeTimer;
          menu.addEventListener('mouseenter', function () {
            window.clearTimeout(closeTimer);
            openTimer = window.setTimeout(function () {
              menu.setAttribute('open', '');
            }, 120);
          });
          menu.addEventListener('mouseleave', function () {
            window.clearTimeout(openTimer);
            closeTimer = window.setTimeout(function () {
              menu.removeAttribute('open');
            }, 150);
          });
          menu.addEventListener('focusin', function () {
            window.clearTimeout(closeTimer);
          });
        });
      }
    </script>
  </body>
</html>
