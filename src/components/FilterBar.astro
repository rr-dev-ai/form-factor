---
interface Option {
  value: string;
  label: string;
}

interface Props {
  /** query 参数名，决定这一行筛的是哪个维度 */
  param: 'region' | 'industry' | 'tag';
  options: Option[];
  clearLabel: string;
}

const { param, options, clearLabel } = Astro.props;
---

<nav class="filter-bar" data-param={param} aria-label={param}>
  {
    options.map((option) => (
      <a
        class="filter-chip"
        href={`?${param}=${option.value}`}
        data-param={param}
        data-value={option.value}
      >
        {option.label}
      </a>
    ))
  }
  <a class="filter-chip filter-chip--clear" href="?" data-param={param}>{clearLabel}</a>
</nav>

<script>
  import { applyFilters, type FilterDocument } from '../scripts/filter';

  // 打包后的模块脚本在 DOM 解析完成后执行，能拿到全部卡片
  applyFilters(document as unknown as FilterDocument, location.search);
</script>
