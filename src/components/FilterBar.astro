---
interface Option {
  value: string;
  label: string;
}

interface Props {
  /** query 参数名，决定这一行筛的是哪个维度 */
  param: 'region' | 'industry';
  options: Option[];
  clearLabel: string;
}

const { param, options, clearLabel } = Astro.props;
const values = options.map((o) => o.value).join(',');
---

<nav class="filter-bar" data-param={param} data-values={values} aria-label={param}>
  {
    options.map((option) => (
      <a class="filter-chip" href={`?${param}=${option.value}`} data-value={option.value}>
        {option.label}
      </a>
    ))
  }
  <a class="filter-chip filter-chip--clear" href="?" hidden>{clearLabel}</a>
</nav>

<script is:inline>
  (function () {
    var bar = document.querySelector('.filter-bar');
    if (!bar) return;
    var key = bar.getAttribute('data-param');
    var valid = (bar.getAttribute('data-values') || '').split(',');
    var value = new URLSearchParams(location.search).get(key);
    // 未知取值一律退回全量，避免 ?region=mars 这种地址把列表清空
    if (!value || valid.indexOf(value) === -1) return;

    bar.querySelectorAll('.filter-chip[data-value]').forEach(function (chip) {
      if (chip.getAttribute('data-value') === value) chip.setAttribute('aria-current', 'true');
    });
    var clear = bar.querySelector('.filter-chip--clear');
    if (clear) clear.hidden = false;

    document.querySelectorAll('[data-region]').forEach(function (el) {
      var own = el.getAttribute('data-' + key) || '';
      if (own.split(',').indexOf(value) === -1) el.hidden = true;
    });
  })();
</script>
