---
import Base from '../../layouts/Base.astro';
import { locales, type Locale } from '../../config/site';
import { t } from '../../lib/i18n';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const dict = t(locale);
---

<Base locale={locale} path="/search" title={dict.search} description={dict.searchHint}>
  <div class="page-head">
    <h1>{dict.search}</h1>
  </div>

  <div class="search-box">
    <input
      id="q"
      type="search"
      placeholder={dict.searchPlaceholder}
      autocomplete="off"
      enterkeyhint="search"
      aria-label={dict.search}
    />
  </div>

  <div class="search-status" id="status"></div>
  <div id="results" class="card-list"></div>

  <div
    id="search-app"
    data-lang={locale}
    data-base={import.meta.env.BASE_URL}
    data-label-results={dict.results}
    data-label-none={dict.noResults}
    data-label-loading={dict.loadingIndex}
    hidden
  >
  </div>
</Base>

<script>
  import MiniSearch from 'minisearch';
  import { searchOptions } from '../../lib/search';

  const app = document.getElementById('search-app') as HTMLElement | null;

  if (app) {
    const lang = app.dataset.lang ?? 'zh';
    const base = (app.dataset.base ?? '/').replace(/\/$/, '');
    const labelResults = app.dataset.labelResults ?? 'results';
    const labelNone = app.dataset.labelNone ?? 'No results';
    const labelLoading = app.dataset.labelLoading ?? 'Loading…';

    const input = document.getElementById('q') as HTMLInputElement;
    const statusEl = document.getElementById('status') as HTMLElement;
    const resultsEl = document.getElementById('results') as HTMLElement;

    const indexes: MiniSearch[] = [];
    let loaded = false;
    let loading: Promise<void> | null = null;

    const escapeHtml = (value: unknown) =>
      String(value).replace(
        /[&<>"']/g,
        (c) =>
          ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] ?? c
      );

    async function load() {
      if (loaded) return;
      if (loading) return loading;

      loading = (async () => {
        statusEl.textContent = labelLoading;
        const manifestResponse = await fetch(`${base}/search-index/${lang}/manifest.json`);
        const manifest = await manifestResponse.json();
        const months: string[] = manifest.months ?? [];

        for (const month of months.slice(0, 2)) {
          const response = await fetch(`${base}/search-index/${lang}/${month}.json`);
          const text = await response.text();
          indexes.push(MiniSearch.loadJSON(text, searchOptions));
        }

        loaded = true;
        statusEl.textContent = '';
      })();

      return loading;
    }

    function render(hits: Array<Record<string, unknown>>) {
      if (hits.length === 0) {
        resultsEl.innerHTML = `<div class="empty"><strong>${escapeHtml(labelNone)}</strong></div>`;
        return;
      }

      resultsEl.innerHTML = hits
        .map((hit) => {
          const tags = ((hit.tagLabels as string[]) ?? [])
            .map((tag) => `<span class="tag">${escapeHtml(tag)}</span>`)
            .join('');
          return `<a class="card" href="${escapeHtml(hit.url)}">
            <div class="card-meta">
              <span>${escapeHtml(hit.date)}</span>
              <span aria-hidden="true">·</span>
              <span>${escapeHtml(hit.industryLabel)}</span>
            </div>
            <h3 class="card-title">${escapeHtml(hit.title)}</h3>
            <p class="card-summary">${escapeHtml(hit.summary)}</p>
            <div class="card-foot">${tags}</div>
          </a>`;
        })
        .join('');
    }

    async function run(query: string) {
      await load();
      const trimmed = query.trim();

      if (!trimmed) {
        resultsEl.innerHTML = '';
        statusEl.textContent = '';
        return;
      }

      const hits = indexes
        .flatMap((index) => index.search(trimmed))
        .sort((a, b) => b.score - a.score)
        .slice(0, 40);

      statusEl.textContent = `${hits.length} ${labelResults}`;
      render(hits as unknown as Array<Record<string, unknown>>);
    }

    let timer: number | undefined;
    input.addEventListener('input', () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => run(input.value), 180);
    });

    const initial = new URLSearchParams(location.search).get('q');
    if (initial) {
      input.value = initial;
      void run(initial);
    }
    input.focus();
  }
</script>
