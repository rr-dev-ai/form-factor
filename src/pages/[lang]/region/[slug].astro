---
import Base from '../../../layouts/Base.astro';
import NewsCard from '../../../components/NewsCard.astro';
import FilterBar from '../../../components/FilterBar.astro';
import { locales, type Locale } from '../../../config/site';
import { industries } from '../../../config/taxonomy';
import { regions, regionName } from '../../../config/regions';
import { byRegion } from '../../../lib/content';
import { t } from '../../../lib/i18n';

export function getStaticPaths() {
  return locales.flatMap((lang) =>
    regions.map((region) => ({ params: { lang, slug: region.slug } }))
  );
}

const locale = Astro.params.lang as Locale;
const slug = Astro.params.slug as string;
const dict = t(locale);

const items = byRegion(slug);

/** 只给有内容的行业出 chip */
const industryOptions = industries
  .map((industry) => ({
    value: industry.slug,
    label: industry.name[locale],
    count: items.filter((item) => item.industry === industry.slug).length,
  }))
  .filter((option) => option.count > 0);
---

<Base
  locale={locale}
  path={`/region/${slug}`}
  title={regionName(slug, locale)}
  description={`${regionName(slug, locale)} · ${items.length}${dict.items}`}
>
  <div class="page-head">
    <h1>{regionName(slug, locale)}</h1>
    <p>{`${items.length} ${dict.items}`}</p>
  </div>

  <FilterBar
    param="industry"
    options={industryOptions}
    clearLabel={dict.filterClear}
  />

  {
    items.length > 0 ? (
      <div class="card-list">
        {items.map((item) => (
          <NewsCard item={item} locale={locale} />
        ))}
      </div>
    ) : (
      <div class="empty">
        <strong>{dict.noRegion}</strong>
        {dict.noRegionHint}
      </div>
    )
  }
</Base>
