---
import Base from '../../layouts/Base.astro';
import NewsCard from '../../components/NewsCard.astro';
import { locales, type Locale } from '../../config/site';
import { industries } from '../../config/taxonomy';
import { allDateKeys, byDate, latestDateKey, toDateKey } from '../../lib/content';
import { t, formatDateParts } from '../../lib/i18n';
import { localePath } from '../../lib/url';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const dict = t(locale);

const latest = latestDateKey();
const latestItems = latest ? byDate(latest) : [];
const latestParts = latest ? formatDateParts(latest, locale) : null;

/**
 * 更早：按天分组，每天最多 4 条、最多 2 天。
 * 原先固定取 8 条，日期一多就会把两三天混成一列，读者只能逐条读卡片里的小字日期。
 */
const olderGroups = allDateKeys()
  .filter((key) => key !== latest)
  .slice(0, 2)
  .map((key) => ({ key, parts: formatDateParts(key, locale), items: byDate(key).slice(0, 4) }))
  .filter((group) => group.items.length > 0);

const todayKey = toDateKey(new Date().toISOString());
const staleDays = latest
  ? Math.round((Date.parse(`${todayKey}T00:00:00Z`) - Date.parse(`${latest}T00:00:00Z`)) / 86400000)
  : 0;
---

<Base locale={locale} path="/">
  <div class="page-head page-head--edition">
    {
      latest && latestParts ? (
        <>
          <h1>{latestParts.date}</h1>
          <span class="sep" aria-hidden="true">·</span>
          <p>{latestParts.weekday}</p>
          <span class="sep" aria-hidden="true">·</span>
          <p>{`${latestItems.length} ${dict.items}`}</p>
        </>
      ) : (
        <h1>{dict.noUpdate}</h1>
      )
    }
  </div>

  {
    staleDays >= 2 && (
      <p class="notice">
        {locale === 'zh' && `距最近一次更新已 ${staleDays} 天，采集任务可能中断，详见运行状态页。`}
        {locale === 'en' && `${staleDays} days since the last update. The daily job may be failing — see Status.`}
        {locale === 'es' && `Han pasado ${staleDays} días desde la última actualización. Consulta Estado.`}
      </p>
    )
  }

  {
    industries.map((industry) => {
      const items = latestItems.filter((i) => i.industry === industry.slug);
      return (
        <section class="section">
          <div class="section-head">
            <h2>{industry.name[locale]}</h2>
            <a href={localePath(locale, `/${industry.slug}`)}>{dict.viewAll} →</a>
          </div>
          {items.length > 0 ? (
            <div class="card-list">
              {items.map((item) => (
                <NewsCard item={item} locale={locale} showIndustry={false} showDate={false} />
              ))}
            </div>
          ) : (
            <div class="empty">
              <strong>{dict.noUpdate}</strong>
              {dict.noUpdateHint}
            </div>
          )}
        </section>
      );
    })
  }

  {
    olderGroups.length > 0 && (
      <section class="section">
        <div class="section-head">
          <h2>{locale === 'zh' ? '更早' : locale === 'en' ? 'Earlier' : 'Anteriores'}</h2>
          <a href={localePath(locale, '/archive')}>{dict.archive} →</a>
        </div>
        {olderGroups.map((group) => (
          <>
            <p class="group-date">
              {group.parts.date}
              <span class="sep" aria-hidden="true">·</span>
              <span class="weekday">{group.parts.weekday}</span>
            </p>
            <div class="card-list card-list--older">
              {group.items.map((item) => (
                <NewsCard item={item} locale={locale} showDate={false} />
              ))}
            </div>
          </>
        ))}
      </section>
    )
  }
</Base>
