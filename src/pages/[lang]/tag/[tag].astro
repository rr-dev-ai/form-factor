---
import Base from '../../../layouts/Base.astro';
import NewsCard from '../../../components/NewsCard.astro';
import { locales, type Locale } from '../../../config/site';
import { tagName, tags } from '../../../config/taxonomy';
import { byTag } from '../../../lib/content';
import { t } from '../../../lib/i18n';
import { localePath } from '../../../lib/url';

export function getStaticPaths() {
  return locales.flatMap((lang) => tags.map((tag) => ({ params: { lang, tag: tag.slug } })));
}

const locale = Astro.params.lang as Locale;
const tagSlug = Astro.params.tag as string;
const dict = t(locale);

const items = byTag(tagSlug);
---

<Base
  locale={locale}
  path={`/tag/${tagSlug}`}
  title={tagName(tagSlug, locale)}
  description={`${tagName(tagSlug, locale)} · ${items.length}${dict.items}`}
>
  <div class="page-head">
    <h1>{tagName(tagSlug, locale)}</h1>
    <p>{`${items.length} ${dict.items}`}</p>
  </div>

  <p class="notice">
    <a href={localePath(locale, '/')}>{dict.backHome}</a>
  </p>

  {
    items.length > 0 ? (
      <div class="card-list">
        {items.map((item) => (
          <NewsCard item={item} locale={locale} />
        ))}
      </div>
    ) : (
      <div class="empty">
        <strong>{dict.noResults}</strong>
      </div>
    )
  }
</Base>
