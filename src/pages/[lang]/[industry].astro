---
import Base from '../../layouts/Base.astro';
import NewsCard from '../../components/NewsCard.astro';
import FilterBar from '../../components/FilterBar.astro';
import { locales, type Locale } from '../../config/site';
import { industries, industryName, tags, tagName } from '../../config/taxonomy';
import { regions } from '../../config/regions';
import { byIndustry } from '../../lib/content';
import { t } from '../../lib/i18n';
import { localePath } from '../../lib/url';

export function getStaticPaths() {
  return locales.flatMap((lang) => industries.map((i) => ({ params: { lang, industry: i.slug } })));
}

const locale = Astro.params.lang as Locale;
const industry = Astro.params.industry as string;
const dict = t(locale);

const items = byIndustry(industry);
const relatedTags = tags.filter((tag) => tag.industry === industry);
---

<Base
  locale={locale}
  path={`/${industry}`}
  title={industryName(industry, locale)}
  description={`${industryName(industry, locale)} · ${items.length}${dict.items}`}
>
  <div class="page-head">
    <h1>{industryName(industry, locale)}</h1>
    <p>{`${items.length} ${dict.items}`}</p>
  </div>

  <div class="card-foot" style="margin-bottom:24px">
    {
      relatedTags.map((tag) => (
        <a class="tag" href={localePath(locale, `/tag/${tag.slug}`)}>
          {tag.name[locale]}
        </a>
      ))
    }
  </div>

  <FilterBar
    param="region"
    options={regions.map((region) => ({ value: region.slug, label: region.name[locale] }))}
    clearLabel={dict.filterClear}
  />

  {
    items.length > 0 ? (
      <div class="card-list">
        {items.map((item) => (
          <NewsCard item={item} locale={locale} />
        ))}
      </div>
    ) : (
      <div class="empty">
        <strong>{dict.noIndustry}</strong>
        {dict.noIndustryHint}
      </div>
    )
  }
</Base>
