---
import Base from '../../layouts/Base.astro';
import NewsCard from '../../components/NewsCard.astro';
import FilterBar from '../../components/FilterBar.astro';
import { locales, type Locale } from '../../config/site';
import { industries, industryName, tags } from '../../config/taxonomy';
import { regions } from '../../config/regions';
import { allRegions, byIndustry } from '../../lib/content';
import { t } from '../../lib/i18n';

export function getStaticPaths() {
  return locales.flatMap((lang) => industries.map((i) => ({ params: { lang, industry: i.slug } })));
}

const locale = Astro.params.lang as Locale;
const industry = Astro.params.industry as string;
const dict = t(locale);

const items = byIndustry(industry);
const relatedTags = tags.filter((tag) => tag.industry === industry);

/** 只给有内容的选项出 chip：点进去一片空白的筛选没有意义 */
const regionOptions = regions
  .map((region) => ({
    value: region.slug,
    label: region.name[locale],
    count: items.filter((item) => allRegions(item).includes(region.slug)).length,
  }))
  .filter((option) => option.count > 0);

const tagOptions = relatedTags
  .map((tag) => ({
    value: tag.slug,
    label: tag.name[locale],
    count: items.filter((item) => item.tags.includes(tag.slug)).length,
  }))
  .filter((option) => option.count > 0);

---

<Base
  locale={locale}
  path={`/${industry}`}
  title={industryName(industry, locale)}
  description={`${industryName(industry, locale)} · ${items.length}${dict.items}`}
>
  <div class="page-head">
    <h1>{industryName(industry, locale)}</h1>
    <p>{`${items.length} ${dict.items}`}</p>
  </div>

  <FilterBar param="region" options={regionOptions} clearLabel={dict.filterClear} />

  <FilterBar param="tag" options={tagOptions} clearLabel={dict.filterClear} />

  {
    items.length > 0 ? (
      <div class="card-list">
        {items.map((item) => (
          <NewsCard item={item} locale={locale} />
        ))}
      </div>
    ) : (
      <div class="empty">
        <strong>{dict.noIndustry}</strong>
        {dict.noIndustryHint}
      </div>
    )
  }
</Base>
