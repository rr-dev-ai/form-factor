---
import Base from '../../layouts/Base.astro';
import { locales, site, type Locale } from '../../config/site';
import { industries } from '../../config/taxonomy';
import { regionName } from '../../config/regions';
import { byDate, coverageOf, loadDays, publishedNews, regionCoverage } from '../../lib/content';
import { t, formatDate } from '../../lib/i18n';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const dict = t(locale);

const allDays = loadDays();
const total = publishedNews().length;

const recent = allDays.slice(0, 7);
const published7 = recent.reduce((sum, day) => sum + byDate(day.date).length, 0);
const fetched7 = recent.reduce((sum, day) => sum + day.fetched, 0);

const latestDate = allDays[0]?.date ?? null;
const lookback = latestDate ? regionCoverage(latestDate, 30) : [];
const windowLabel = latestDate
  ? `${recent[recent.length - 1].date} — ${latestDate}`
  : dict.noRuns;

/**
 * 一天的条数与覆盖一律由内容推得，不用 runs.json 里的计数：
 * 历史记录是「每行业一条」合并来的，条数不全；内容才是真相。
 */
function dayView(day: (typeof allDays)[number]) {
  const items = byDate(day.date);
  const counts = industries.map(
    (industry) => items.filter((item) => item.industry === industry.slug).length
  );
  const { covered, missing } = coverageOf(day.date, items);
  return { counts, covered, missing, total: items.length };
}

const views = allDays.map((day) => dayView(day));

function regionCell(view: (typeof views)[number]) {
  const names = view.covered.map((region) => regionName(region.slug, locale)).join(' ');
  const gap = view.missing.length
    ? dict.missingRegions.replace('{n}', String(view.missing.length))
    : '';
  return [names, gap].filter(Boolean).join(' · ') || '—';
}

function underTarget(view: (typeof views)[number]) {
  const short = view.counts.some((count) => count < site.perIndustryDailyMin);
  return short || view.missing.length > 0;
}
---

<Base locale={locale} path="/status" title={dict.statusTitle}>
  <div class="page-head">
    <h1>{dict.statusTitle}</h1>
    <p>{windowLabel}</p>
  </div>

  <section class="run">
    <div class="metrics">
      <div><b>{published7}</b>{dict.publishedItems}</div>
      <div><b>{fetched7}</b>{dict.fetched}</div>
      <div><b>{total}</b>{dict.items} · {dict.total}</div>
    </div>
  </section>

  {
    allDays.length > 0 ? (
      <section class="section day-list">
        <div class="day-head">
          <span>{dict.date}</span>
          {industries.map((industry) => (
            <span>{industry.name[locale]}</span>
          ))}
          <span>{dict.regions}</span>
          <span>{dict.dayTotal}</span>
        </div>

        {allDays.map((day, index) => (
          <details class="day-row" data-under={underTarget(views[index]) ? 'true' : undefined}>
            <summary>
              <span class="day-date">{day.date.slice(5)}</span>
              {views[index].counts.map((count) => (
                <span class="day-cell">{count}</span>
              ))}
              <span class="day-regions">{regionCell(views[index])}</span>
              <span class="day-total">{views[index].total}</span>
            </summary>
            <div class="day-detail">
              {day.published === views[index].total ? (
                <div class="metrics">
                  <div><b>{day.fetched}</b>{dict.fetched}</div>
                  <div><b>{day.afterDedup}</b>{dict.dedup}</div>
                  <div><b>{day.passed}</b>{dict.gate}</div>
                  <div><b>{day.published}</b>{dict.publishedItems}</div>
                </div>
              ) : (
                <p class="day-meta">—</p>
              )}
              <p class="day-meta">
                {formatDate(day.startedAt, locale, true)} · {Math.round(day.durationMs / 1000)}s
                {day.supplement.triggered && ` · ${dict.supplement} ${day.supplement.items}`}
              </p>
            </div>
          </details>
        ))}
      </section>
    ) : (
      <div class="empty"><strong>{dict.noRuns}</strong></div>
    )
  }

  {
    lookback.length > 0 && (
      <section class="section">
        <h2 class="lookback-title">{dict.regionCoverage}</h2>
        <p class="lookback">
          {lookback
            .map((row) => `${regionName(row.slug, locale)} ${row.days}/${row.total}`)
            .join(' · ')}
        </p>
      </section>
    )
  }
</Base>
